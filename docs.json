{
  "$schema": "https://mintlify.com/docs.json",
  "name": "B3D Nav",
  "theme": "aspen",
  "colors": {
    "primary": "#E87B2E",
    "light": "#F5A96B",
    "dark": "#C05A10"
  },
  "navbar": {
    "primary": {
      "type": "github",
